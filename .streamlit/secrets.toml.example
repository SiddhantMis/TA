# Add real values in Community Cloud only AFTER setting the app private and
# verifying an anonymous browser is denied. Never commit secrets.toml.
TRACKER_ENV = "staging"
DATABASE_URL = "postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
