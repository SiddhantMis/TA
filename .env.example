# Reference only: the CLI reads process environment and does not load .env files.
# Put real values in private server settings, environment secrets, or a secret manager.
TRACKER_ENV=staging
TRACKER_SHADOW_MODE=true
TRACKER_NOTIFY_ENABLED=false
TRACKER_SESSION_OVERRIDES={}

# Supabase Connect -> Session pooler (5432), with a URL-encoded database password.
# Session pooling is required for the worker's session-level advisory lock.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_IN_PRIVATE_SERVER_SETTINGS
TRACKER_STORAGE_BUCKET=tracker-inputs

# Run python -m scanner_tracker password-hash; never store the plaintext password here.
TRACKER_APP_PASSWORD_HASH=REPLACE_WITH_PASSWORD_HASH_COMMAND_OUTPUT
GITHUB_REPOSITORY=SiddhantMis/TA
# Optional, Streamlit server only; a token allowed to dispatch this repository's workflow.
GITHUB_DISPATCH_TOKEN=

# Local synthetic preview ONLY; never enable either line in staging or production.
# TRACKER_ENV=local
# TRACKER_DEMO=1
